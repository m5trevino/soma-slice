# somas/ holds the Soma graphs for real sessions. Each soma.json carries
# Message nodes with the verbatim user and assistant text, so it is chat
# log content under a different name. Track it deliberately or not at all.
somas/

# Databases ARE tracked. Only SQLite's transient sidecar files are not:
# they are rewritten constantly and corrupt the repo if half-copied.
*.db-wal
*.db-shm
*.json-wal
*.json-shm
*.sqlite3

